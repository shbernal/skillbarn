{
  "name": "skillbarn",
  "version": "0.0.0",
  "description": "Vendor agent skills into a project, reproducibly, from a committed lockfile",
  "type": "module",
  "bin": {
    "skb": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "check:fix": "biome check --write",
    "test": "vitest run",
    "record-fixtures": "node scripts/record-fixtures.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.0.0",
    "fast-check": "4.9.0",
    "lefthook": "2.1.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
