{
  "name": "skillbarn",
  "version": "0.2.1",
  "description": "Vendor agent skills into a project, reproducibly, from a committed lockfile",
  "author": "shbernal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/skillbarn.git"
  },
  "homepage": "https://github.com/shbernal/skillbarn#readme",
  "bugs": "https://github.com/shbernal/skillbarn/issues",
  "keywords": [
    "agent-skills",
    "skills",
    "clawhub",
    "claude-code",
    "openclaw",
    "opencode",
    "lockfile",
    "vendoring",
    "cli"
  ],
  "type": "module",
  "bin": {
    "skb": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "publint": "publint",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "record-fixtures": "node scripts/record-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "4.10.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
