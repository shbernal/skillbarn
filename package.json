{
  "name": "skillbarn",
  "version": "0.2.0",
  "description": "Vendor agent skills into a project, reproducibly, from a committed lockfile",
  "author": "shbernal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/skillbarn.git"
  },
  "homepage": "https://github.com/shbernal/skillbarn#readme",
  "bugs": "https://github.com/shbernal/skillbarn/issues",
  "keywords": [
    "agent-skills",
    "skills",
    "clawhub",
    "claude-code",
    "openclaw",
    "opencode",
    "lockfile",
    "vendoring",
    "cli"
  ],
  "type": "module",
  "bin": {
    "skb": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "publint": "publint",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "check:fix": "biome check --write",
    "test": "vitest run",
    "record-fixtures": "node scripts/record-fixtures.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.0.0",
    "fast-check": "4.9.0",
    "lefthook": "2.1.10",
    "publint": "0.3.22",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
