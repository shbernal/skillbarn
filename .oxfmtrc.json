{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/",
    "test/fixtures/",
    "pnpm-lock.yaml",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml"
  ]
}
